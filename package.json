{
  "name": "jazari-one-redesign",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.x"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "build:pages": "bun run build",
    "test": "bun run build:pages && bun run test:content",
    "test:content": "bun test tests/rendered-html.test.mjs",
    "test:e2e": "bun --bun playwright test",
    "test:e2e:update": "bun --bun playwright test --update-snapshots",
    "test:all": "bun run test && bun run lint && bun run test:e2e",
    "lint": "bun --bun eslint . --ignore-pattern .next"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@paper-design/shaders-react": "^0.0.77",
    "glimm": "^0.3.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
